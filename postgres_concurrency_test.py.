import psycopg2
from psycopg2 import pool
import threading
import time
import random
import sys

# Standard connection parameters targeting local postgres background daemon
DB_URI = "dbname=postgres user=postgres password=labs_gate_99 host=127.0.0.1 port=5432"

try:
    connection_pool = psycopg2.pool.ThreadedConnectionPool(minconn=1, maxconn=10, dsn=DB_URI)
    print("🏁 CONNECTION POOL SUCCESS: Threaded allocation pool checked out cleanly.\n")
except Exception as e:
    print(f"💥 POOL INITIALIZATION CRASH: Verify Postgres background daemon status! Error: {e}")
    sys.exit(1)

def process_production_webhook_transaction(tenant_id, booking_id, new_status):
    """
    Executes actual PostgreSQL transactions. Utilizes database-level FOR UPDATE NOWAIT
    row distributed isolation boundaries to handle concurrent streams safely without blocks.
    """
    print(f"📡 INBOUND SURGE WIRE: [{tenant_id}] targeting Booking {booking_id} -> [{new_status}]")
    
    # Injected traffic latency jitter simulation utility to emulate real-world parallel spikes
    time.sleep(random.uniform(0.01, 0.05))
    
    conn = connection_pool.getconn()
    try:
        with conn.cursor() as cursor:
            # 1. Simulate authentication configuration context natively inside the transaction
            cursor.execute(f"SET LOCAL request.jwt.claim.tenant_id = '{tenant_id}';")
            
            # 2. Row-Level Distributed Locking. If a parallel transaction has locked this row, Postgres throws immediately.
            cursor.execute("""
                SELECT status FROM replyflow_ledger 
                WHERE booking_id = %s AND status = 'PENDING' 
                FOR UPDATE NOWAIT;
            """, (booking_id,))
            
            result = cursor.fetchone()
            if not result:
                print(f"🚨 RECONCILIATION FILTER: Booking {booking_id} for [{tenant_id}] is no longer PENDING.")
                return
                
            # 3. Safe mutation execution on the protected physical database block
            cursor.execute("""
                UPDATE replyflow_ledger 
                SET status = %s 
                WHERE booking_id = %s;
            """, (new_status, booking_id))
            
            conn.commit()
            print(f"🔒 SECURED DATABASE COMMIT: Booking {booking_id} successfully locked down as [{new_status}]!")
            
    except Exception as e:
        conn.rollback()
        print(f"💥 DATABASE CONCURRENCY COLLISION INTERCEPTED LIVE: {str(e).strip()}")
    finally:
        connection_pool.putconn(conn)

if __name__ == "__main__":
    print("🚀 RUNWAY OPEN: Launching concurrent thread traffic surges against real Postgres...\n")
    
    thread_one = threading.Thread(target=process_production_webhook_transaction, args=("tenant_alpha", 101, "CONFIRMED"))
    thread_two = threading.Thread(target=process_production_webhook_transaction, args=("tenant_alpha", 101, "CANCELLED"))
    
    thread_one.start(); thread_two.start()
    thread_one.join(); thread_two.join()
    
    connection_pool.closeall()
